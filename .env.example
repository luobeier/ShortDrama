# --- Database ---
# SQLite (local default):
DATABASE_URL="file:./dev.db"
# Supabase (Postgres) — grab both from Dashboard → Connect → ORMs → Prisma.
# DATABASE_URL goes through the transaction pooler (port 6543); DIRECT_URL is
# the direct connection (port 5432) that Prisma uses for db push / migrations.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- NextAuth ---
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-me-in-production-please-0000"
NEXTAUTH_URL="http://localhost:3000"

# --- Dev login ---
# When true, a passwordless "quick sign in by email" provider is enabled so the
# app is fully usable without configuring SMTP or OAuth. Turn OFF in production.
ENABLE_DEV_LOGIN="true"

# --- Google OAuth (optional) ---
# Enabled automatically when both values are present.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email magic link (optional) ---
# Enabled automatically when EMAIL_SERVER + EMAIL_FROM are present.
# Example: smtp://user:pass@smtp.example.com:587
EMAIL_SERVER=""
EMAIL_FROM="DramaScore <no-reply@dramascore.app>"

# --- Admin ---
# Comma-separated emails that can access /admin. Leave blank to disable admin.
ADMIN_EMAILS=""
